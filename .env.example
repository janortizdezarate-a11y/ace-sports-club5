# Environment Variables — Ace Sport Club
# Copy this file to .env.local for local development.
# Set these as Environment Variables in your Vercel project dashboard.

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase (server-side) ────────────────────────────────────────────────────
# Get the SERVICE ROLE key (never expose this in the browser) from:
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://hdysujzyabenovvnwauf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...YOUR_SERVICE_ROLE_KEY

# ── App Domain ────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (no trailing slash). Used for Stripe redirect URLs.
# e.g. https://ace-sport-club.vercel.app  OR  https://www.acesportclub.es
DOMAIN=https://your-vercel-url.vercel.app
